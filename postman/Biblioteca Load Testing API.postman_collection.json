{
  "info": {
    "name": "Biblioteca Load Testing API",
    "description": "Coleccion para probar el backend en memoria usado en demos de JMeter.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "bookId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/health"
      }
    },
    {
      "name": "Libros",
      "item": [
        {
          "name": "Get all",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/books"
          }
        },
        {
          "name": "Get all con searchText",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/books?searchText=borges",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "books"
              ],
              "query": [
                {
                  "key": "searchText",
                  "value": "borges"
                }
              ]
            }
          }
        },
        {
          "name": "Crear libro",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('bookId', body.id);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"La ciudad y los perros\",\n  \"author\": \"Mario Vargas Llosa\",\n  \"year\": 1963,\n  \"genre\": \"Novela\",\n  \"available\": true\n}"
            },
            "url": "{{baseUrl}}/books"
          }
        },
        {
          "name": "Get por id",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/books/{{bookId}}"
          }
        },
        {
          "name": "Modificar libro",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"La ciudad y los perros - Edicion de prueba\",\n  \"author\": \"Mario Vargas Llosa\",\n  \"year\": 1963,\n  \"genre\": \"Novela\",\n  \"available\": false\n}"
            },
            "url": "{{baseUrl}}/books/{{bookId}}"
          }
        },
        {
          "name": "Eliminar libro",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": "{{baseUrl}}/books/{{bookId}}"
          }
        }
      ]
    },
    {
      "name": "Carga",
      "item": [
        {
          "name": "Carga CPU",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"iterations\": 250000,\n  \"rounds\": 8\n}"
            },
            "url": "{{baseUrl}}/load/cpu"
          }
        },
        {
          "name": "Carga memoria",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"size\": 50000\n}"
            },
            "url": "{{baseUrl}}/load/memory"
          }
        }
      ]
    }
  ]
}
